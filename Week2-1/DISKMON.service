DISKMON.service
[Unit]
Description=Disk Usage Monitor Agent
Documentation=https://wiki.example.com/diskmon
#start after system is booted and all filesystems are mounted
After=local-fs.target
# We want network but we dont need it
Wants=network-online.target
After=network-online.target
[Service]
# Run as non-root system user
User=diskmon
Group=diskmon

#Load config from env
EnvironmentFile=/etc/diskmon.env

# Full path to exe
ExecStart=/opt/diskmon/diskmon.sh

# Restart if it exits unexpectedly
# on-failure restart on unclean exit
Restart=on-failure
RestartSec=10s

#Tag log entries in journal
SyslogIdentifier=diskmon

# redirect stdout/err to journal
StandardOutput=journal
StandardError=journal

# Timeout: if it doesn't start in 30s mark as failed
TimeoutStartSec=30s

# give the process 15s to exit cleanly before sigkill
TimeoutStopSec=15s

[Install]
# start at normal system boot (Multi-user mode)
WantedBy=multi-user.target
